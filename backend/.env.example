# ============================================
# AI小说生成器 - 后端环境变量配置
# 复制此文件为 .env 并修改为您的实际配置
# ============================================

# 服务器配置
PORT=3000
NODE_ENV=development

# 数据库配置 (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=ai_novel_generator

# Redis 缓存配置（可选，用于提升性能）
# 格式: redis://host:port 或 redis://username:password@host:port
# 如果使用本地 Redis，保持默认值即可
REDIS_URL=redis://localhost:6379

# JWT 配置
JWT_SECRET=your_super_secret_key_change_this_in_production
JWT_EXPIRES_IN=7d

# AI API 配置
# 支持: openai, siliconflow, deepseek, custom
DEFAULT_AI_PROVIDER=siliconflow
OPENAI_API_KEY=your_openai_key
SILICONFLOW_API_KEY=your_siliconflow_key
DEEPSEEK_API_KEY=your_deepseek_key

# 可选: 自定义 AI API 端点
CUSTOM_API_URL=
CUSTOM_API_KEY=

# 日志级别 (debug, info, warn, error)
LOG_LEVEL=info

# 限流配置
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30

# ============================================
# 生产环境额外配置
# ============================================

# 如果使用云 Redis (如 Redis Cloud / Upstash)
# REDIS_URL=redis://default:password@your-redis-host:6379

# 如果使用 Docker
# DB_HOST=db
# REDIS_URL=redis://redis:6379
